[Unit]
Description=Pi Vision headless Hailo YOLO browser demo
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/pi-vision
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/user/pi-vision/scripts/run-camera.sh --host 0.0.0.0 --port 8000 --camera 0 --fps 15
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
